# End-to-end test build.
#
# Deliberately points at a host that does not exist: every Supabase call in the
# E2E suite is intercepted by Playwright (see e2e/fixtures.ts), and this makes
# it impossible for a test run to reach the real project — or a real payment
# endpoint — if an interception is ever missed.
VITE_SUPABASE_URL="https://e2e.invalid"
VITE_SUPABASE_PROJECT_ID="e2e"
VITE_SUPABASE_PUBLISHABLE_KEY="e2e-anon-key-not-real"
VITE_SENTRY_DSN=
VITE_MONRI_ENABLED=false
