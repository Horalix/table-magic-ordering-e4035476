# The offline demo (docs/demo-mode.md): `npm run dev:demo`, `npm run build:demo`.
#
# No Supabase project. The address below does not exist; every request the app
# sends to it is answered in the browser by src/demo, from a database that
# lives in the browser too. Nothing here is a secret.
VITE_DEMO_MODE=true
VITE_SUPABASE_URL="https://demo.tableflow.invalid"
VITE_SUPABASE_PROJECT_ID="demo"
VITE_SUPABASE_PUBLISHABLE_KEY="demo-publishable-key-not-real"
VITE_SENTRY_DSN=
